# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# e.g. http://localhost:3000 locally, the Netlify URL in production
NEXT_PUBLIC_SITE_URL=
# Server only. Enables "Fill with AI" on job cards (Google Gemini free tier, key from aistudio.google.com).
# Free-tier prompts may be used by Google to improve its products. Leave blank to turn AI off.
GEMINI_API_KEY=
